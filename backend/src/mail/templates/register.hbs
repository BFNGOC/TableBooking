<html>
  <head>
    <title>TableBooking Verification</title>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
  </head>

  <body
    style='
      margin: 0;
      padding: 0;
      background-color: #f5f1ed;
      font-family: Arial, sans-serif;
      color: #3b2a22;
    '
  >
    <div
      style='
        max-width: 620px;
        margin: 40px auto;
        background-color: #fffaf7;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #eadfd7;
      '
    >

      <!-- Header -->
      <div
        style='
          background: linear-gradient(135deg, #3b2a22, #6b4a3a);
          padding: 40px 30px;
          text-align: center;
        '
      >
        <h1
          style='
            margin: 0;
            color: #f8f3ef;
            font-size: 34px;
            letter-spacing: 1px;
          '
        >
          TableSpot
        </h1>

        <p
          style='
            margin-top: 12px;
            color: #e8d9cf;
            font-size: 15px;
          '
        >
          Luxury Restaurant Reservation Experience
        </p>
      </div>

      <!-- Content -->
      <div style='padding: 40px 32px;'>

        <p
          style='
            margin-top: 0;
            font-size: 18px;
          '
        >
          Hello
          <strong>{{name}}</strong>,
        </p>

        <p
          style='
            color: #6b5b52;
            line-height: 1.8;
          '
        >
          Thank you for joining TableSpot. Your account is almost ready. Please
          use the verification code below to activate your account.
        </p>

        <!-- OTP Box -->
        <div
          style='
            margin: 40px 0;
            text-align: center;
          '
        >
          <div
            style='
              display: inline-block;
              padding: 18px 42px;
              background-color: #6b4a3a;
              border-radius: 18px;
              color: white;
              font-size: 36px;
              font-weight: bold;
              letter-spacing: 10px;
              box-shadow: 0 10px 30px rgba(107, 74, 58, 0.2);
            '
          >
            {{activationCode}}
          </div>
        </div>

        <div
          style='
            background-color: #f8f1eb;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
          '
        >
          <p style='margin: 0; color: #5a463c;'>
            ⏳ This verification code will expire in
            <strong>5 minutes</strong>.
          </p>
        </div>

        <p
          style='
            color: #6b5b52;
            line-height: 1.8;
          '
        >
          If you did not create a TableSpot account, you can safely ignore this
          email.
        </p>

        <p
          style='
            margin-top: 40px;
            line-height: 1.8;
          '
        >
          Best regards,<br />
          <strong>TableSpot Team</strong>
        </p>
      </div>

      <!-- Footer -->
      <div
        style='
          background-color: #f1e7df;
          padding: 24px;
          text-align: center;
          color: #7b685d;
          font-size: 14px;
        '
      >
        <p style='margin-top: 0;'>
          Discover and reserve premium dining experiences.
        </p>

        <p style='margin-bottom: 0;'>
          © 2026 TableSpot. All rights reserved.
        </p>
      </div>

    </div>
  </body>
</html>