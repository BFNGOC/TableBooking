{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",

            "name": "Nest Debug",

            "runtimeExecutable": "npm",

            "runtimeArgs": ["run", "start:debug"],

            "cwd": "${workspaceFolder}/backend",

            "console": "integratedTerminal",

            "restart": true,

            "protocol": "auto",

            "port": 9229,

            "autoAttachChildProcesses": true,

            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
